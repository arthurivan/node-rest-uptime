# Environment Configuration for Node REST Uptime Monitor
# Copy this file to .env and update with your actual values

# Node Environment (staging or production)
NODE_ENV=staging

# Security
HASHING_SECRET=your-secure-hashing-secret-here

# Twilio Configuration for WhatsApp notifications
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_PHONE=+your-twilio-whatsapp-number

# Production Configuration (only needed for production)
PORT=5000
BASE_URL=https://your-domain.com/
